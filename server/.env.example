# Copy these values into the AI service host's environment; never put the real key in Vite or source control.
PORT=8787
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
# Existing authenticated app API endpoint that returns success only for a valid bearer token.
AUTH_INTROSPECTION_URL=https://YOUR_APP_API_DOMAIN/api/auth/preferences
# Add the exact deployed frontend origin(s), comma-separated. Local Vite origins are allowed by default.
AI_ALLOWED_ORIGINS=https://YOUR_OPEN_CHARTING_DOMAIN
AI_RATE_LIMIT_PER_MINUTE=8
AI_MAX_REQUESTS_PER_USER_PER_DAY=20
AI_MAX_REQUESTS_PER_DAY=100
# Set true only when deployed behind a trusted proxy that overwrites forwarding headers.
TRUST_PROXY=false
