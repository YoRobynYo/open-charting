+import { describe, expect, it } from "vitest";
+import type { Candle } from "../services/schemas.ts";
+import { detectCandlePatternAt } from "../lib/candle-patterns.ts";
+
+function candle(time: number, open: number, high: number, low: number, close: number): Candle {
+  return { time, open, high, low, close, volume: 1 };
+}
+
+/** Six steady candles, each 10 wide: falling or rising by 8 per candle. */
+function trend(direction: "down" | "up"): Candle[] {
+  return Array.from({ length: 6 }, (_, i) => {
+    const open = direction === "down" ? 200 - 8 * i : 100 + 8 * i;
+    const close = direction === "down" ? open - 6 : open + 6;
+    return candle(i, open, Math.max(open, close) + 2, Math.min(open, close) - 2, close);
+  });
+}
+
+// Same hammer shape in both colours: long lower wick, small body, close near the top.
+const redHammerShape = candle(6, 150, 150.5, 140, 148);
+const greenHammerShape = candle(6, 146, 148.5, 138, 148);
+
+describe("hammer vs hanging man uses the move before the candle", () => {
+  it("calls a red hammer shape after a fall a hammer", () => {
+    expect(detectCandlePatternAt([...trend("down"), redHammerShape], 6).pattern).toBe("hammer");
+  });
+
+  it("calls a green hammer shape after a rise a hanging man", () => {
+    expect(detectCandlePatternAt([...trend("up"), greenHammerShape], 6).pattern).toBe("hanging-man");
+  });
+
+  it("keeps a hammer a hammer after a fall", () => {
+    expect(detectCandlePatternAt([...trend("down"), greenHammerShape], 6).pattern).toBe("hammer");
+  });
+
+  it("keeps a hanging man a hanging man after a rise", () => {
+    expect(detectCandlePatternAt([...trend("up"), redHammerShape], 6).pattern).toBe("hanging-man");
+  });
+
+  it("falls back to the colour rule when there is no history to read", () => {
+    expect(detectCandlePatternAt([redHammerShape], 0).pattern).toBe("hanging-man");
+    expect(detectCandlePatternAt([greenHammerShape], 0).pattern).toBe("hammer");
+  });
+});
