+type PriorTrend = "up" | "down" | "flat";
+
+/** Which way price was heading over the candles just before `index`. */
+function priorTrend(candles: readonly Candle[], index: number): PriorTrend {
+  if (index < TREND_LOOKBACK) return "flat";
+  let rangeTotal = 0;
+  for (let i = index - TREND_LOOKBACK; i < index; i++) {
+    const previous = candles[i]!;
+    rangeTotal += previous.high - previous.low;
+  }
+  const averageRange = rangeTotal / TREND_LOOKBACK;
+  const move = candles[index - 1]!.close - candles[index - TREND_LOOKBACK]!.close;
+  if (move >= averageRange * TREND_MIN_MOVE_VS_RANGE) return "up";
+  if (move <= -averageRange * TREND_MIN_MOVE_VS_RANGE) return "down";
+  return "flat";
+}
+
+/**
+ * A hammer and a hanging man share one shape. What separates them is where price
+ * was heading before: after a fall the shape is a hammer, after a rise it is a
+ * hanging man, whatever the candle colour. With no clear trend the colour rule
+ * from detectRejectionCandle stays.
+ */
+function applyTrendContext(
+  candles: readonly Candle[],
+  index: number,
+  result: CandlePatternResult,
+): CandlePatternResult {
+  if (result.pattern !== "hammer" && result.pattern !== "hanging-man") return result;
+  const trend = priorTrend(candles, index);
+  if (trend === "down" && result.pattern === "hanging-man") {
+    return {
+      ...result,
+      pattern: "hammer",
+      visualState: "hammer-candidate",
+      explanation: "Long lower wick, compact body and a close in the upper part of the range after a fall: a hammer, whatever the candle colour.",
+    };
+  }
+  if (trend === "up" && result.pattern === "hammer") {
+    return {
+      ...result,
+      pattern: "hanging-man",
+      visualState: "hanging-man-candidate",
+      explanation: "Long lower wick, compact body and a close in the upper part of the range after a rise: a hanging man, whatever the candle colour.",
+    };
+  }
+  return result;
+}
+
