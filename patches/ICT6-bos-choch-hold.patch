+/**
+ * The retest and the hold: a thin line carries on from the break back to the
+ * candle that touched the level, a ring marks that candle, and a HOLD tag with
+ * an arrow sits just past the wick on the far side of the level (below for a
+ * bullish hold, above for a bearish one) so it never covers the candle.
+ */
+function drawHold(
+  ctx: CanvasRenderingContext2D,
+  h: {
+    x1: number;
+    xr: number;
+    y: number;
+    yExtreme: number;
+    direction: "bullish" | "bearish";
+    color: string;
+    width: number;
+    hpr: number;
+    vpr: number;
+    tagH: number;
+  },
+) {
+  const { hpr, vpr, color } = h;
+  const bullish = h.direction === "bullish";
+
+  ctx.save();
+  ctx.globalAlpha = 0.55;
+  ctx.strokeStyle = color;
+  ctx.beginPath();
+  ctx.moveTo(h.x1, h.y);
+  ctx.lineTo(h.xr, h.y);
+  ctx.stroke();
+  ctx.restore();
+
+  ctx.fillStyle = "rgba(15, 23, 42, 0.95)";
+  ctx.strokeStyle = color;
+  ctx.beginPath();
+  ctx.arc(h.xr, h.y, 3.5 * hpr, 0, Math.PI * 2);
+  ctx.fill();
+  ctx.stroke();
+
+  const text = bullish ? "HOLD \u25B2" : "HOLD \u25BC";
+  const tagW = ctx.measureText(text).width + 10 * hpr;
+  const cx = Math.min(Math.max(h.xr, tagW / 2), h.width - tagW / 2);
+  const gap = 5 * vpr;
+  const cy = bullish
+    ? Math.max(h.yExtreme, h.y) + gap + h.tagH / 2
+    : Math.min(h.yExtreme, h.y) - gap - h.tagH / 2;
+  ctx.fillStyle = "rgba(15, 23, 42, 0.92)";
+  ctx.fillRect(cx - tagW / 2, cy - h.tagH / 2, tagW, h.tagH);
+  ctx.strokeRect(cx - tagW / 2, cy - h.tagH / 2, tagW, h.tagH);
+  ctx.fillStyle = color;
+  ctx.fillText(text, cx, cy);
+}
