+/**
+ * The first candle after the break that reaches back to the level and closes
+ * on the right side of it: a bullish break holds when a low touches the level
+ * and the candle still closes above it, a bearish break the other way round.
+ */
+function findHold(
+  closed: readonly IctCandle[],
+  breakIndex: number,
+  direction: StructureBreak["direction"],
+  price: number,
+  maxBars: number,
+): StructureRetest | undefined {
+  const hit = closed
+    .slice(breakIndex + 1, breakIndex + 1 + maxBars)
+    .find((candle) => direction === "bullish"
+      ? candle.low <= price && candle.close >= price
+      : candle.high >= price && candle.close <= price);
+  if (!hit) return undefined;
+  return { time: hit.time, extreme: direction === "bullish" ? hit.low : hit.high };
+}
 
